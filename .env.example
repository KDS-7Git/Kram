# Copy to .env for local development. Production secrets use the *_FILE equivalents.
NODE_ENV=development
PORT=8420
HOST=127.0.0.1
DATABASE_URL=postgresql://kram:change-me@127.0.0.1:5432/kram
SESSION_SECRET=
ENCRYPTION_KEY=
APP_URL=http://localhost:8420
TRUST_PROXY=0
COOKIE_SECURE=false
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
# Docker storage should be a folder on SSD; works on amd64 and arm64.
POSTGRES_DATA_DIR=./data/postgres
POSTGRES_PASSWORD=
BIND_ADDRESS=127.0.0.1
APP_PORT=8420
KRAM_IMAGE=kram:local
LOCAL_UID=1000
LOCAL_GID=1000
DEV_DATABASE_PORT=5432
CADDY_BIND_ADDRESS=127.0.0.1
# Optional Caddy; choose a hostname reachable through your VPN/proxy/tunnel.
APP_DOMAIN=localhost
NTFY_DOMAIN=ntfy.localhost
NTFY_BASE_URL=http://ntfy:80
NTFY_TOKEN=
NTFY_TOPIC=
# Backups are encrypted before upload; an S3-compatible provider is optional.
BACKUP_DIR=./backups
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=kram
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
