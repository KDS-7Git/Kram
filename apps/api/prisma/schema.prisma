generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model SystemMeta {
  key String @id
  value Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@map("system_meta")
}

model User {
  id String @id @db.Uuid
  email String @unique
  passwordHash String
  isOwner Boolean @default(true)
  timezone String @default("Asia/Kolkata")
  dayRollover Int @default(240)
  settings Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  profiles Profile[]
  skills Skill[]
  auditLogs AuditLog[]
  goals Goal[]
  goalRules GoalRuleVersion[]
  resources Resource[]
  resourceItems ResourceItem[]
  goalResources GoalResource[]
  itemDependencies ItemDependency[]
  tasks Task[]
  progressEvents ProgressEvent[]
  goalProgressCaches GoalProgressCache[]
  timeSlots TimeSlot[]
  taskDependencies TaskDependency[]
  reminderRules ReminderRule[]
  notifications Notification[]
  notificationAttempts NotificationAttempt[]
  jobRuns JobRun[]
  @@map("app_user")
}

model Profile {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  name String
  icon String @default("BookOpen")
  color String @default("teal")
  sortOrder Int @default(0)
  archivedAt DateTime? @db.Timestamptz(3)
  isDemo Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  skills Skill[]
  timeSlots TimeSlot[]
  @@unique([id,userId])
  @@index([userId,sortOrder,id])
  @@map("profile")
}

model Skill {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  profileId String @db.Uuid
  profile Profile @relation(fields:[profileId,userId],references:[id,userId],onDelete:Restrict)
  name String
  priority Int?
  usePriority String @default("inherit")
  dailyTargetMin Int @default(30)
  weeklyTargetMin Int @default(150)
  maxDailyMin Int @default(180)
  availableDays Int[] @default([1,2,3,4,5,6])
  windows Json @default("[]")
  sortOrder Int @default(0)
  archivedAt DateTime? @db.Timestamptz(3)
  isDemo Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  goals Goal[]
  resources Resource[]
  timeSlots TimeSlot[]
  @@unique([id,userId])
  @@index([userId,profileId,sortOrder,id])
  @@map("skill")
}

model Goal {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  skillId String @db.Uuid
  skill Skill @relation(fields:[skillId,userId],references:[id,userId],onDelete:Restrict)
  type String
  title String
  unit String @default("minutes")
  targetQty Float
  startDate DateTime @db.Date
  dueDate DateTime? @db.Date
  priority Int?
  usePriority String @default("inherit")
  status String @default("active")
  ruleVersion Int @default(1)
  scheduleMode String @default("combined")
  estMinutes Int @default(30)
  availableDays Int[] @default([1,2,3,4,5,6])
  rrule String?
  sortOrder Int @default(0)
  archivedAt DateTime? @db.Timestamptz(3)
  isDemo Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  rules GoalRuleVersion[]
  resources GoalResource[]
  primaryResources Resource[]
  tasks Task[]
  progressEvents ProgressEvent[]
  progressCache GoalProgressCache?
  timeSlots TimeSlot[]
  @@unique([id,userId])
  @@index([userId,skillId,status,sortOrder,id])
  @@map("goal")
}

model GoalRuleVersion {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  goalId String @db.Uuid
  goal Goal @relation(fields:[goalId,userId],references:[id,userId],onDelete:Restrict)
  version Int
  effectiveFrom DateTime @db.Date
  rules Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  progressEvents ProgressEvent[]
  @@unique([id,userId])
  @@unique([goalId,version])
  @@index([userId,goalId,effectiveFrom,version])
  @@map("goal_rule_version")
}

model Resource {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  skillId String @db.Uuid
  skill Skill @relation(fields:[skillId,userId],references:[id,userId],onDelete:Restrict)
  goalId String? @db.Uuid
  goal Goal? @relation(fields:[goalId,userId],references:[id,userId],onDelete:Restrict)
  type String
  title String
  url String?
  notesRef String?
  archivedAt DateTime? @db.Timestamptz(3)
  isDemo Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  items ResourceItem[]
  goals GoalResource[]
  @@unique([id,userId])
  @@index([userId,skillId,createdAt,id])
  @@map("resource")
}

model GoalResource {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  goalId String @db.Uuid
  goal Goal @relation(fields:[goalId,userId],references:[id,userId],onDelete:Restrict)
  resourceId String @db.Uuid
  resource Resource @relation(fields:[resourceId,userId],references:[id,userId],onDelete:Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([goalId,resourceId])
  @@index([userId,resourceId])
  @@map("goal_resource")
}

model ResourceItem {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  resourceId String @db.Uuid
  resource Resource @relation(fields:[resourceId,userId],references:[id,userId],onDelete:Restrict)
  parentItemId String? @db.Uuid
  parent ResourceItem? @relation("ResourceTree",fields:[parentItemId,resourceId,userId],references:[id,resourceId,userId],onDelete:Restrict)
  children ResourceItem[] @relation("ResourceTree")
  ordinal Int @default(0)
  title String
  kind String @default("task")
  estMinutes Int @default(30)
  durationMin Int?
  qty Float @default(1)
  url String?
  pagesFrom Int?
  pagesTo Int?
  archivedAt DateTime? @db.Timestamptz(3)
  isDemo Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  dependencies ItemDependency[] @relation("ItemDepends")
  dependants ItemDependency[] @relation("ItemRequired")
  tasks Task[]
  @@unique([id,userId])
  @@unique([id,resourceId,userId])
  @@index([userId,resourceId,parentItemId,ordinal,id])
  @@map("resource_item")
}

model ItemDependency {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  resourceId String @db.Uuid
  itemId String @db.Uuid
  item ResourceItem @relation("ItemDepends",fields:[itemId,resourceId,userId],references:[id,resourceId,userId],onDelete:Restrict)
  dependsOnItemId String @db.Uuid
  prerequisite ResourceItem @relation("ItemRequired",fields:[dependsOnItemId,resourceId,userId],references:[id,resourceId,userId],onDelete:Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([itemId,dependsOnItemId])
  @@index([userId,resourceId])
  @@map("item_dependency")
}

model Task {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  goalId String @db.Uuid
  goal Goal @relation(fields:[goalId,userId],references:[id,userId],onDelete:Restrict)
  itemId String? @db.Uuid
  item ResourceItem? @relation(fields:[itemId,userId],references:[id,userId],onDelete:Restrict)
  title String
  estMinutes Int
  remainingMinutes Float
  qty Float @default(1)
  completedQty Float @default(0)
  actualMinutes Float @default(0)
  status String @default("pending")
  earliestDate DateTime @db.Date
  dueDate DateTime? @db.Date
  supportsSplit Boolean @default(true)
  sortOrder Int @default(0)
  periodKey String
  materializationKey String @unique
  timerStartedAt DateTime? @db.Timestamptz(3)
  timerAccumulatedMinutes Float @default(0)
  deferredToDate DateTime? @db.Date
  unverified Boolean @default(false)
  eventVersion Int @default(0)
  manualOverride Boolean @default(false)
  archivedAt DateTime? @db.Timestamptz(3)
  isDemo Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  events ProgressEvent[]
  slots TimeSlot[]
  dependencies TaskDependency[] @relation("TaskDepends")
  dependants TaskDependency[] @relation("TaskRequired")
  notifications Notification[]
  @@unique([id,userId])
  @@unique([goalId,itemId,periodKey])
  @@index([userId,goalId,status,dueDate])
  @@index([userId,earliestDate,status,id])
  @@map("task")
}

model TaskDependency {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  taskId String @db.Uuid
  task Task @relation("TaskDepends",fields:[taskId,userId],references:[id,userId],onDelete:Restrict)
  dependsOnTaskId String @db.Uuid
  prerequisite Task @relation("TaskRequired",fields:[dependsOnTaskId,userId],references:[id,userId],onDelete:Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([taskId,dependsOnTaskId])
  @@index([userId,taskId])
  @@map("task_dependency")
}

model ProgressEvent {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  taskId String? @db.Uuid
  task Task? @relation(fields:[taskId,userId],references:[id,userId],onDelete:Restrict)
  goalId String @db.Uuid
  goal Goal @relation(fields:[goalId,userId],references:[id,userId],onDelete:Restrict)
  ruleVersionId String? @db.Uuid
  ruleVersion GoalRuleVersion? @relation(fields:[ruleVersionId,userId],references:[id,userId],onDelete:Restrict)
  kind String
  sequence Int @default(0)
  minutes Float @default(0)
  qty Float @default(0)
  reportedTotalMinutes Float?
  reportedTotalQty Float?
  occurredAt DateTime @db.Timestamptz(3)
  localDate DateTime @db.Date
  timezone String
  clientEventId String @unique @db.Uuid
  requestHash String @default("")
  note String @default("")
  referenceEventId String? @db.Uuid
  reference ProgressEvent? @relation("EventCorrections",fields:[referenceEventId,userId],references:[id,userId],onDelete:Restrict)
  corrections ProgressEvent[] @relation("EventCorrections")
  toDate DateTime? @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([id,userId])
  @@unique([taskId,sequence])
  @@index([userId,taskId,createdAt,id])
  @@index([userId,goalId,localDate])
  @@map("progress_event")
}

model GoalProgressCache {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  goalId String @unique @db.Uuid
  goal Goal @relation(fields:[goalId,userId],references:[id,userId],onDelete:Restrict)
  minutes Float @default(0)
  qty Float @default(0)
  completions Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([goalId,userId])
  @@map("goal_progress_cache")
}

model TimeSlot {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  date DateTime @db.Date
  startMin Int
  endMin Int
  layer String @default("flexible")
  title String
  profileId String? @db.Uuid
  profile Profile? @relation(fields:[profileId,userId],references:[id,userId],onDelete:Restrict)
  skillId String? @db.Uuid
  skill Skill? @relation(fields:[skillId,userId],references:[id,userId],onDelete:Restrict)
  goalId String? @db.Uuid
  goal Goal? @relation(fields:[goalId,userId],references:[id,userId],onDelete:Restrict)
  taskId String? @db.Uuid
  task Task? @relation(fields:[taskId,userId],references:[id,userId],onDelete:Restrict)
  pinned Boolean @default(false)
  version Int @default(1)
  templateId String? @db.Uuid
  archivedAt DateTime? @db.Timestamptz(3)
  isDemo Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([id,userId])
  @@index([userId,date,layer,startMin])
  @@map("time_slot")
}

model ReminderRule {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  ownerType String
  ownerId String? @db.Uuid
  type String @default("task_reminder")
  atLocal Int?
  offsetMin Int?
  repeatPolicy String @default("once")
  enabled Boolean @default(true)
  channel String @default("ntfy")
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  notifications Notification[]
  @@unique([id,userId])
  @@index([userId,ownerType,ownerId])
  @@map("reminder_rule")
}

model Notification {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  channel String @default("ntfy")
  type String
  title String
  body String
  scheduledFor DateTime @db.Timestamptz(3)
  status String @default("pending")
  dedupeKey String
  ownerType String @default("global")
  ownerId String? @db.Uuid
  reminderRuleId String? @db.Uuid
  reminderRule ReminderRule? @relation(fields:[reminderRuleId,userId],references:[id,userId],onDelete:Restrict)
  taskId String? @db.Uuid
  task Task? @relation(fields:[taskId,userId],references:[id,userId],onDelete:Restrict)
  isTest Boolean @default(false)
  nextAttemptAt DateTime? @db.Timestamptz(3)
  attemptCount Int @default(0)
  leaseId String? @db.Uuid
  leaseUntil DateTime? @db.Timestamptz(3)
  sentAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  attempts NotificationAttempt[]
  @@unique([id,userId])
  @@unique([userId,dedupeKey])
  @@index([status,nextAttemptAt,scheduledFor])
  @@map("notification")
}

model NotificationAttempt {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  notificationId String @db.Uuid
  notification Notification @relation(fields:[notificationId,userId],references:[id,userId],onDelete:Restrict)
  attemptedAt DateTime @default(now()) @db.Timestamptz(3)
  outcome String
  httpStatus Int?
  errorCode String?
  leaseId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([notificationId,leaseId])
  @@index([userId,notificationId,attemptedAt])
  @@map("notification_attempt")
}

model JobRun {
  id String @id @db.Uuid
  userId String? @db.Uuid
  user User? @relation(fields:[userId],references:[id],onDelete:Restrict)
  jobName String
  periodKey String
  startedAt DateTime @db.Timestamptz(3)
  finishedAt DateTime @db.Timestamptz(3)
  status String @default("succeeded")
  detail Json @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([jobName,periodKey])
  @@map("job_run")
}

model AuditLog {
  id String @id @db.Uuid
  userId String? @db.Uuid
  user User? @relation(fields:[userId],references:[id],onDelete:Restrict)
  action String
  ip String?
  detail Json @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId,createdAt])
  @@map("audit_log")
}

model AuthLockout {
  key String @id
  failures Int @default(0)
  lockedUntil DateTime? @db.Timestamptz(3)
  lastFailure DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@map("auth_lockout")
}

model Session {
  sid String @id @db.VarChar(255)
  sess Json
  expire DateTime @db.Timestamptz(6)
  @@index([expire])
  @@map("session")
}
